# herdr-server.service — the headless herdr server the relay bridge drives and the
# laptop attaches to with `herdr --remote {{.User}}@<host>`. Written by `relay pair`.
#
# `herdr server` runs in the foreground, needs no tty, and listens on
# ~/.config/herdr/herdr.sock, so plain Type=simple is enough.
[Unit]
Description=Herdr terminal workspace server
Documentation=https://herdr.dev
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{.User}}
WorkingDirectory={{.Home}}
Environment=HOME={{.Home}}
Environment=RELAY_ON_BOX=1
Environment=TERM=xterm-256color
Environment={{.Path}}
{{- if .Socket}}
Environment={{.Socket}}
{{- end}}
ExecStart={{.Herdr}} server
ExecStop={{.Herdr}} server stop
Restart=always
RestartSec=2
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
